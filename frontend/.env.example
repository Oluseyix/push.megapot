# ─────────────────────────────────────────────────────────────────────────────
# Push — environment variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Push contract
# ─────────────────────────────────────────────────────────────────────────────

# Push's deployed address on the active chain (see VITE_CHAIN below). Not
# deployed yet as of this fork - see the repo README "Deploy target". Every
# read/write against Push fails until this is set to a real address.
VITE_PUSH_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# Chain + RPC
#
# These two vars must agree. Base Sepolia (testnet) is the deploy target
# for now - see the repo README.
# ─────────────────────────────────────────────────────────────────────────────

# Chain to use. Determines which USDC address + RPC are wired up.
#   mainnet — Base mainnet (production), chain ID 8453
#   testnet — Base Sepolia (free test USDC), chain ID 84532
VITE_CHAIN=testnet

# RPC endpoint for the active chain.
#
# DEFAULT (public RPC): rate-limited, fine for casual local dev only.
# For reliable testing, swap to a free dedicated endpoint (Alchemy,
# QuickNode, Infura, Ankr, etc. — any HTTPS Base RPC works).
VITE_RPC_URL=https://sepolia.base.org
# VITE_RPC_URL=https://mainnet.base.org

# ─────────────────────────────────────────────────────────────────────────────
# Wallet provider
# ─────────────────────────────────────────────────────────────────────────────

# WalletConnect project ID. Get a free one at https://cloud.walletconnect.com
# (~2 min signup). Optional but recommended.
#
#   Set:    full RainbowKit modal — WalletConnect QR, Rainbow, MetaMask
#           mobile, plus injected wallets and Coinbase Wallet.
#   Empty:  degraded mode — only browser-extension wallets (MetaMask,
#           Rabby, Brave, Phantom, etc.) and Coinbase Wallet (its own SDK).
VITE_WALLETCONNECT_PROJECT_ID=

# App name shown in wallet-connect modals (RainbowKit / WalletConnect).
VITE_APP_NAME=Push
