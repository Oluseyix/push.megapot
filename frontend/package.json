{
  "name": "push-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Push - a real-stakes crash-style climb built on Megapot. Forked from the Megapot starter kit.",
  "scripts": {
    "bootstrap": "cp -n .env.example .env && pnpm install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check"
  },
  "dependencies": {
    "@inco/lightning-js": "^1.0.2",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "buffer": "^6.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "viem": "2.55.11"
    }
  }
}
